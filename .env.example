# Application / API
RAG_APP_NAME=RAG CV Platform
RAG_APP_VERSION=0.1.0
RAG_DEBUG=true
RAG_HOST=127.0.0.1
RAG_PORT=8000
RAG_API_PREFIX=/api/v1
RAG_CORS_ORIGINS=http://localhost:3000

# Logging
LOG_LEVEL=INFO
LOG_TO_FILE=false
LOG_DIR=logs

# Shared MinIO artifact storage
MINIO_ENDPOINT=localhost:9100
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET=cvs

# Qdrant vector database
QDRANT_URL=http://localhost:6333

# CV ingestion pipeline
CV_INGESTION_COLLECTION_NAME=cvs_collection
CV_INGESTION_CHUNKS_DEBUG_DIR=outputs/ingestion_chunks
CV_INGESTION_WRITE_DEBUG_CHUNKS=true

# LiteLLM proxy used by CV enrichment / RAG assistant
CV_LLM_DEFAULT_MODEL=default-llm
CV_LLM_QUALITY_MODEL=quality-llm
CV_LITELLM_BASE_URL=http://localhost:4000

# Profile image generation
# Prefer CV_HF_API_TOKEN for consistency with ImageGenerationSettings.
# HF_API_TOKEN is also supported and takes precedence when set.
CV_HF_API_TOKEN=hf_your_token_here
# HF_API_TOKEN=
CV_IMAGE_WIDTH=512
CV_IMAGE_HEIGHT=512
CV_IMAGE_GUIDANCE=3.5
CV_IMAGE_STEPS=28

# Synthetic CV generation (CLI / pipeline runs)
CV_COUNT=1
CV_OUTPUT_DIR=outputs
CV_SEED=
